# Pflicht — Verbindung zur PostgreSQL-Datenbank.
# Lokal:   postgres://localhost:5432/wanderparkplatz
# Vercel:  gepoolten Endpunkt des Anbieters verwenden (Neon: "-pooler" im Host)
DATABASE_URL=postgres://localhost:5432/wanderparkplatz

# Pflicht — kanonische Adresse, fließt in Canonicals, Sitemap und robots.txt.
NEXT_PUBLIC_SITE_URL=https://wanderparkplatz.info

# Pflicht für Bewertungen. Ohne diesen Wert ist die Bewertungsfunktion
# abgeschaltet: ein ungesalzener Hash einer IP-Adresse wäre rückrechenbar.
# Erzeugen mit: openssl rand -hex 32
BEWERTUNG_SALT=

# "vor" = Vormoderation (Voreinstellung), "sofort" = direkt öffentlich
BEWERTUNG_FREIGABE=vor

# Optional — Obergrenze der Datenbankverbindungen je Funktionsinstanz.
# PG_POOL_MAX=3
